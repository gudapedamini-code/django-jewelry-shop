# Production Environment Configuration Template
# Copy this file to .env and replace with your actual values

# Security & Debug Settings
DEBUG=False
SECRET_KEY=replace-with-a-secure-50-character-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost,your-app.onrender.com,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com,https://yourdomain.com

# Database (PostgreSQL URL for Render/Railway/AWS, or leave empty for local SQLite)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Email Settings (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=Golden Glamour <your_email@gmail.com>

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SSL Security (Set to False for local HTTP, True for production HTTPS)
SECURE_SSL_REDIRECT=False
